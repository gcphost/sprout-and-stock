node_modules/
dist/

# The live database. Content lives here while you play; `npm run export`
# writes it back out to data/seed/*.json, and those ARE committed.
data/game.db
data/game.db-wal
data/game.db-shm

.env
.env.local
*.log
.DS_Store

# Colyseus devMode's hot-reload scratch file. Rewritten on every server
# restart, so committing it means a conflict every time you both save a file.
.devmode.json

# Page snapshots the Playwright MCP browser drops as it drives the game.
.playwright-mcp/

# Scratch databases. `SNS_DB` points a headless run at a throwaway copy, and a
# before/after pair dropped in the repo root is a measurement rather than a
# thing anybody else needs. The live one is already covered above.
/*.db
/*.db-wal
/*.db-shm

# Screenshots taken while looking at something. The `screenshot` tool hands the
# PNG straight back to whoever asked, so one landing in the repo root is scratch
# by definition — worth keeping locally, never worth committing.
/*.png

# Benchmark scratch. Throwaway runs, not part of the sweeps.
scripts/.tmp/

# Probes written while chasing one bug — one-off scripts and whatever database
# copy they were pointed at. A sweep that is worth keeping goes in scripts/ and
# is named in `npm run verify`; everything else in here is a measurement.
scratch-tmp/

# The web build. Same reason `dist/` is here: it is output, and `npm run
# deploy` rebuilds it on the way to Cloudflare Pages.
dist-web/
